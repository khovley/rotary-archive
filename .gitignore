.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Archive data: masters are irreplaceable but far too large for git.
# Back these up separately (Time Machine / Synology / external drive).
archive.db
archive.db-journal
archive.db-wal
inbox/*
masters/
derivatives/
exports/
!inbox/.gitkeep

# site/ IS tracked: it is published via GitHub Pages so the rendered archive
# can be linked and designed against. It contains only generated output from
# synthetic test data - no real club material.

# Never commit credentials.
.env
secrets.toml
